# Локальный PostgreSQL. В Docker Compose DB_HOST переопределяется на postgres.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=stroyka

# Redis. В Docker Compose REDIS_HOST переопределяется на redis.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=super_secret_key_change_in_production
JWT_EXPIRATION=86400s

# Cloudinary. Для каталога и корзины ключи не вызываются, плейсхолдеры достаточны.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Application
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Администратор создаётся при первом старте, если такого email ещё нет
ADMIN_EMAIL=admin@stroyka.com
ADMIN_PASSWORD=Admin123!
